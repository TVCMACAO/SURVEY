# Django Settings
# Generate a new secret key: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-change-this-in-production

# Debug mode (0 = False, 1 = True)
DEBUG=0

# Allowed hosts (comma-separated list)
# For EasyPanel, include your domain: easypanel.clinicamaicao.com,www.clinicamaicao.com
ALLOWED_HOSTS=easypanel.clinicamaicao.com,www.clinicamaicao.com,localhost,127.0.0.1

# MongoDB Settings
# For EasyPanel, use the MongoDB connection string from EasyPanel
MONGO_URI=mongodb://root:1b20629a87ea780a63aa@easypanel.clinicamaicao.com:27017/?authSource=admin&tls=false
MONGO_DB_NAME=survey_db

# Alternative MongoDB settings (if not using MONGO_URI)
# MONGO_USERNAME=root
# MONGO_PASSWORD=your-password-here
# MONGO_HOST=easypanel.clinicamaicao.com
# MONGO_PORT=27017

# Optional: Additional CORS origins (comma-separated)
# CORS_ALLOWED_ORIGINS=https://example.com,http://example.com
