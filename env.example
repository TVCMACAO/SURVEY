# Django Settings
# Generate: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-change-this-in-production

# Debug mode (0 = False, 1 = True)
DEBUG=1

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.248,chat-survey-app.rhfh8t.easypanel.host

# MongoDB (remote production DB — set real credentials in .env, never commit .env)
MONGO_URI=mongodb://USER:PASSWORD@easypanel.clinicamaicao.com:27017/?authSource=admin&tls=false
MONGO_DB_NAME=survey_db

# Public site URL (attachment preview links)
BASE_URL=http://localhost:8085

