# Ejemplo de variables para usar la BD MongoDB en easypanel.clinicamaicao.com
# Copiar a .env y ajustar si hace falta.

# BD única: todo (encuestas, respuestas, adjuntos, preview_link) en esta MongoDB
MONGO_URI=mongodb://root:1b20629a87ea780a63aa@easypanel.clinicamaicao.com:27017/?tls=false
MONGO_DB_NAME=survey_db

# URL pública del sitio (para links de adjuntos y comando populate_attachment_preview_links)
BASE_URL=https://chat-survey-app.rhfh8t.easypanel.host

# Django (requeridas en EasyPanel)
SECRET_KEY=tu-clave-secreta-django
ALLOWED_HOSTS=chat-survey-app.rhfh8t.easypanel.host,localhost

# Si los links públicos de adjuntos devuelven 404: la app debe usar esta misma MONGO_URI
# (misma BD donde están encuestas, respuestas y adjuntos). En EasyPanel, definir MONGO_URI en variables de entorno.
